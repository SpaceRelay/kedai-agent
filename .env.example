# ===== Kedai 服务端配置 =====
# 复制为 .env 后按需修改;API Key 仅存于服务端内存/环境,绝不暴露给前端。

# 监听地址与端口
HOST=127.0.0.1
PORT=3001
# 非 loopback 监听必须显式设为 1,并配置至少 32 字符的固定 token。
KEDAI_ALLOW_REMOTE=0
# 留空时每次启动生成 256-bit 随机 bearer token;仅测试/外部客户端需要固定覆盖。
KEDAI_API_TOKEN=

# 数据目录(相对项目根),存放 SQLite 与角色卡原图
DATA_DIR=./data

# 日志目录(相对项目根);桌面应用(Tauri)场景自动指向 %APPDATA%\com.kedai.app\logs,无需配置
LOG_DIR=./logs

# OpenAI 兼容后端(可指向 OpenAI / 任意中转 / Oobabooga --api / vLLM 等)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# 非 Windows 默认拒绝把 API Key 明文写入 settings.json。仅在理解风险后显式设为 1。
KEDAI_ALLOW_INSECURE_PLAINTEXT_SECRETS=0
OPENAI_MODEL=gpt-4o-mini

# 后端连接器类型: openai-compatible | mock(无 Key 时演示用)
CONNECTOR=openai-compatible

# 生成参数默认值(可在前端「设置」中直接修改并持久化到 data/settings.json,优先于 .env)
DEFAULT_TEMPERATURE=0.8
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=1024
DEFAULT_MAX_CONTEXT_TOKENS=8192

# 前端开发服务器地址(Vite dev 代理目标)
WEB_DEV_PORT=5173
